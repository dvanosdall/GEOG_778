# ==============================================================================
# Gitignore configuration for Omaha Urban Heat Mitigation Toolkit
# ==============================================================================

# Python virtual environments
venv/
.venv/
env/

# Node.js dependencies
node_modules/

# Python cache files
__pycache__/
*.py[cod]

# Environment variables / secrets
.env
.env.*

# IDE settings
.vscode/
.idea/

# OS-generated files
.DS_Store
Thumbs.db

# Ignore local frontend config containing sensitive credentials
Frontend/js/config.js

# Ignore backend and database config environment secrets
.env
Backend/.env
